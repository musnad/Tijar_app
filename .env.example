# Copy to .env.local (gitignored)

VITE_SUPABASE_URL=https://ongsfahnfknqelyhuxrt.supabase.co
# Dashboard: Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=

VITE_APP_ENV=development

# Public site URL — required for production deploy & Android APK (no trailing slash)
# VITE_PUBLIC_APP_URL=https://www.tijar.ng

# Server-only — never prefix with VITE_
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / ChatGPT (server-only — NEVER prefix with VITE_; never commit real keys)
# Primary AI for: text translate, voice STT (Whisper), TTS, speech translate
# Get a key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ElevenLabs — personal voice clone for TIJAR speak-back (server-only)
# Used when the shopkeeper records their voice in onboarding / settings
# Get a key: https://elevenlabs.io → Profile → API Keys
# ELEVENLABS_API_KEY=sk_...

# Optional comma-separated Origins for /api/translate* /api/speak (in addition to VITE_PUBLIC_APP_URL)
# TRANSLATE_ALLOWED_ORIGINS=

# xAI Grok — voice-to-listing, captions, weekly tips, Imagine flyers/video
# Server-only — NEVER prefix with VITE_. Listings/sales still save without this.
# Get a key: https://console.x.ai
# XAI_API_KEY=xai-...   # or grok_...
# GROK_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# Future AI providers (server-only — add when ready; never use VITE_ prefix)
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# DEEPGRAM_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Web Push (browser notifications that arrive even when the site is closed)
# Generate a key pair once:  npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY is public (shipped to the browser).
# VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY are server-only (never prefix with VITE_).
# PUSH_WEBHOOK_SECRET must match the app.push_notify_secret set in Postgres
# (see supabase/migrations/20260307000050_push_subscriptions.sql).
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:hello@tijar.ng
# PUSH_WEBHOOK_SECRET=

# Marketplace payments (server-only — never VITE_). Until these exist, checkout
# sends an order REQUEST and never marks paid from the browser.
# Also required: a webhook that verifies the provider signature and updates
# payments.status + orders.status (idempotent on provider_reference).
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# Webhook: https://www.tijar.ng/api/payments/webhook
# Flutterwave dashboard → Webhooks → verif-hash = FLUTTERWAVE_WEBHOOK_HASH (same secret as dashboard)
# Paystack HMAC still accepted as fallback. Needs SUPABASE_SERVICE_ROLE_KEY.
# FLUTTERWAVE_WEBHOOK_HASH=
